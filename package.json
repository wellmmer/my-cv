{
  "name": "my-cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "leak": "tsx scripts/leak.ts",
    "prepare": "simple-git-hooks",
    "shots": "tsx scripts/shots.ts",
    "pdf": "tsx scripts/pdf.ts",
    "pdf:private": "CV_PRIVATE=1 tsx scripts/pdf.ts --private",
    "private:code": "tsx scripts/private-code.ts",
    "private:publish": "tsx scripts/private-publish.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@vercel/blob": "^2.8.2",
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run leak && npm run typecheck"
  }
}
